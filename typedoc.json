{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/ppsspp-wasm.ts"
  ],
  "out": "site",
  "name": "@wasm-gaming/ppsspp-wasm",
  "includeVersion": true,
  "readme": "README.md",
  "githubPages": true,
  "hideGenerator": true,
