diff --git a/Core/Config.cpp b/Core/Config.cpp
index c7000c41a..bb338e5bf 100644
--- a/Core/Config.cpp
+++ b/Core/Config.cpp
@@ -1176,6 +1176,29 @@ ConfigBlock *GetConfigBlockForSection(std::string_view sectionName) {
 
 const size_t numSections = ARRAY_SIZE(g_sectionMeta);
 
+bool SetConfigValueFromString(std::string_view sectionName, std::string_view key, std::string_view value) {
+	for (const ConfigSectionMeta &meta : g_sectionMeta) {
+		if (!equals(meta.section, sectionName)) {
+			continue;
+		}
+		for (size_t j = 0; j < meta.settingsCount; j++) {
+			const ConfigSetting &setting = meta.settings[j];
+			if (!equals(setting.IniKey(), key)) {
+				continue;
+			}
+			// Everything needed to turn a string into whichever type this setting is
+			// already exists — it is how the ini is read — and it takes a Section. So
+			// the value is handed over in one, rather than by teaching this file the
+			// type switch a second time.
+			IniFile ini;
+			Section *section = ini.GetOrCreateSection(sectionName);
+			section->Set(key, value);
+			return setting.ReadFromIniSection(meta.configBlock, section, false);
+		}
+	}
+	return false;
+}
+
 std::map<const void *, std::pair<const ConfigBlock *, const ConfigSetting *>> &Config::getPtrLUT() {
 	static std::map<const void *, std::pair<const ConfigBlock *, const ConfigSetting *>> lut;
 	return lut;
