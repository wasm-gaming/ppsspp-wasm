diff --git a/Core/WebBridge.cpp b/Core/WebBridge.cpp
new file mode 100644
index 000000000..3886c5929
--- /dev/null
+++ b/Core/WebBridge.cpp
@@ -0,0 +1,239 @@
+// See WebBridge.h. The contract this implements lives in ../../src/module.ts.
+
+#ifdef __EMSCRIPTEN__
+
+#include <emscripten.h>
+
+#include <mutex>
+#include <vector>
+
+#include "Common/Log.h"
+#include "Common/StringUtils.h"
+#include "Common/System/System.h"
+#include "Common/TimeUtil.h"
+#include "Core/Config.h"
+#include "Core/Core.h"
+#include "Core/CoreParameter.h"
+#include "Core/ELF/ParamSFO.h"
+#include "Core/HW/Display.h"
+#include "Core/System.h"
+#include "Core/WebBridge.h"
+
+namespace PpssppWeb {
+
+// Events are emitted from one place and one thread — see Frame() — so anything that
+// happens elsewhere lands here first. A queue rather than a direct call because the
+// producers are not on the browser's main thread: a boot fails on PPSSPP's loading
+// thread, a save state finishes on whichever thread ran it, and calling into JS from
+// either is either illegal or asynchronous.
+struct Pending {
+	enum class Kind { Error, SaveState } kind;
+	std::string message;
+	int slot = 0;
+	bool saved = false;
+};
+
+static std::mutex g_pendingLock;
+static std::vector<Pending> g_pending;
+
+// What has already been said, so that a poll does not say it twice.
+static bool g_bootedEmitted = false;
+static bool g_exitEmitted = false;
+static bool g_wasIngame = false;
+static bool g_wasPauseMenu = false;
+static bool g_quitRequested = false;
+static double g_lastFpsAt = 0.0;
+
+// One place where C++ speaks to the host, and it is deliberately not a JSON string:
+// every event is built as an object in JS from arguments that cross as numbers and
+// pointers, so nothing here has to escape a game title.
+static void EmitBooted(const char *gameId, const char *title, const char *region) {
+	EM_ASM({
+		const emit = Module['ppssppEvent'];
+		if (emit) emit({ type: 'booted', gameId: UTF8ToString($0), title: UTF8ToString($1), region: UTF8ToString($2) });
+	}, gameId, title, region);
+}
+
+static void EmitError(const char *message) {
+	EM_ASM({
+		const emit = Module['ppssppEvent'];
+		if (emit) emit({ type: 'error', message: UTF8ToString($0) });
+	}, message);
+}
+
+static void EmitExit() {
+	EM_ASM({
+		const emit = Module['ppssppEvent'];
+		if (emit) emit({ type: 'exit' });
+	});
+}
+
+static void EmitFps(double fps, double vps) {
+	EM_ASM({
+		const emit = Module['ppssppEvent'];
+		if (emit) emit({ type: 'fps', fps: $0, vps: $1 });
+	}, fps, vps);
+}
+
+static void EmitSaveState(int slot, bool saved) {
+	EM_ASM({
+		const emit = Module['ppssppEvent'];
+		if (emit) emit({ type: 'saveState', slot: $0, action: $1 ? 'saved' : 'loaded' });
+	}, slot, saved ? 1 : 0);
+}
+
+static void EmitPause(bool paused) {
+	EM_ASM({
+		const emit = Module['ppssppEvent'];
+		if (emit) emit({ type: $0 ? 'pause' : 'resume' });
+	}, paused ? 1 : 0);
+}
+
+void NotifyError(std::string_view message) {
+	std::lock_guard<std::mutex> guard(g_pendingLock);
+	g_pending.push_back(Pending{ Pending::Kind::Error, std::string(message), 0, false });
+}
+
+void NotifySaveState(int slot, bool saved) {
+	std::lock_guard<std::mutex> guard(g_pendingLock);
+	g_pending.push_back(Pending{ Pending::Kind::SaveState, std::string(), slot, saved });
+}
+
+bool Frame() {
+	if (g_quitRequested) {
+		// One frame of grace has already passed since ppsspp_web_shutdown(), which is
+		// what gives REQUEST_GAME_STOP a turn of the loop to be seen. Stopping here is
+		// what makes SDLMain cancel the browser main loop and join the emu thread.
+		return false;
+	}
+
+	{
+		std::vector<Pending> drained;
+		{
+			std::lock_guard<std::mutex> guard(g_pendingLock);
+			drained.swap(g_pending);
+		}
+		for (const Pending &event : drained) {
+			switch (event.kind) {
+			case Pending::Kind::Error: EmitError(event.message.c_str()); break;
+			case Pending::Kind::SaveState: EmitSaveState(event.slot, event.saved); break;
+			}
+		}
+	}
+
+	const GlobalUIState uiState = GetUIState();
+	const bool ingame = uiState == UISTATE_INGAME || uiState == UISTATE_PAUSEMENU;
+
+	// `booted` is what resolves the promise start() returned, so it means "a game is
+	// up", not "main() ran". PSP_IsInited() is the boot having completed; the UI state
+	// is the frontend having actually switched to it, which is the point at which the
+	// next frame drawn is the game's.
+	if (!g_bootedEmitted && ingame && PSP_IsInited()) {
+		const std::string gameId = g_paramSFO.GetDiscID();
+		const std::string title = g_paramSFO.GetValueString("TITLE");
+		const std::string region = std::string(GameRegionToString(DetectGameRegionFromID(gameId)));
+		EmitBooted(gameId.c_str(), title.c_str(), region.c_str());
+		g_bootedEmitted = true;
+		g_lastFpsAt = time_now_d();
+	}
+
+	// PPSSPP's *own* pause menu, and only that. The pause this package triggers through
+	// ppsspp_web_pause is reported by the SDK on the JS side — emitting it here as well
+	// would have a host see every host-initiated pause twice.
+	const bool pauseMenu = uiState == UISTATE_PAUSEMENU;
+	if (pauseMenu != g_wasPauseMenu) {
+		g_wasPauseMenu = pauseMenu;
+		EmitPause(pauseMenu);
+	}
+
+	if (g_bootedEmitted && !g_exitEmitted) {
+		const double now = time_now_d();
+		if (now - g_lastFpsAt >= 1.0) {
+			g_lastFpsAt = now;
+			float vps = 0.0f, fps = 0.0f;
+			__DisplayGetAveragedFPS(&vps, &fps);
+			EmitFps(fps, vps);
+		}
+	}
+
+	// The user quit from PPSSPP's own UI: the frontend is back at its game list, which
+	// for a session this package started means the game it was started for is over.
+	if (g_wasIngame && !ingame && !g_exitEmitted) {
+		g_exitEmitted = true;
+		EmitExit();
+	}
+	g_wasIngame = ingame;
+
+	return true;
+}
+
+}  // namespace PpssppWeb
+
+extern "C" {
+
+// `Section/Key`, in PPSSPP's own ini vocabulary — "Graphics/InternalResolution" — plus
+// the value as a string. ../../src/settings.ts is the complete list of what can arrive,
+// and only what ../../src/spec.ts advertises as `live: true` is ever sent.
+//
+// Returns 1 when the setting was applied and 0 for a key this build does not know,
+// which the SDK reports rather than swallowing.
+EMSCRIPTEN_KEEPALIVE int ppsspp_web_apply_setting(const char *key, const char *value) {
+	if (!key || !value) {
+		return 0;
+	}
+	const std::string_view full(key);
+	const size_t slash = full.find('/');
+	if (slash == std::string_view::npos) {
+		WARN_LOG(Log::System, "web: setting '%s' is not Section/Key", key);
+		return 0;
+	}
+	const std::string_view section = full.substr(0, slash);
+	const std::string_view name = full.substr(slash + 1);
+
+	// `Web/` is this package's own namespace: keys that PPSSPP has no ini entry for
+	// because they are runtime state rather than configuration.
+	if (section == "Web") {
+		if (name == "FastForward") {
+			const bool on = equalsNoCase(value, "true") || equalsNoCase(value, "1");
+			PSP_CoreParameter().fastForward = on;
+			return 1;
+		}
+		WARN_LOG(Log::System, "web: unknown Web/ setting '%s'", key);
+		return 0;
+	}
+
+	if (!SetConfigValueFromString(section, name, value)) {
+		WARN_LOG(Log::System, "web: no setting '%s'", key);
+		return 0;
+	}
+	return 1;
+}
+
+// Debug break and resume, which is how PPSSPP itself implements a pause with no menu —
+// see VIRTKEY_PAUSE_NO_MENU in UI/EmuScreen.cpp. The emulation stops and the last frame
+// stays on the canvas; no screen is pushed, so a host's own pause UI is the only one a
+// player sees.
+EMSCRIPTEN_KEEPALIVE void ppsspp_web_pause(void) {
+	if (PSP_IsInited() && !Core_IsStepping()) {
+		Core_Break(BreakReason::UIPause);
+	}
+}
+
+EMSCRIPTEN_KEEPALIVE void ppsspp_web_resume(void) {
+	if (PSP_IsInited() && Core_IsStepping()) {
+		Core_Resume();
+	}
+}
+
+// Stop, as cleanly as a browser tab allows. The game is asked to stop through the same
+// message PPSSPP's own UI posts, and the main loop is told to end on the next turn —
+// which is what joins the emu thread rather than leaving it running under a module the
+// host is about to drop.
+EMSCRIPTEN_KEEPALIVE void ppsspp_web_shutdown(void) {
+	System_PostUIMessage(UIMessage::REQUEST_GAME_STOP);
+	PpssppWeb::g_quitRequested = true;
+}
+
+}  // extern "C"
+
+#endif  // __EMSCRIPTEN__
diff --git a/Core/WebBridge.h b/Core/WebBridge.h
new file mode 100644
index 000000000..3500f06dd
--- /dev/null
+++ b/Core/WebBridge.h
@@ -0,0 +1,34 @@
+// The whole of what a browser host can ask of PPSSPP, and what PPSSPP tells it back.
+//
+// The seam this implements is specified in JavaScript, not here: ../../src/module.ts
+// declares the four `ppsspp_web_*` entry points and the shape of every event, and the
+// SDK is written against that declaration alone. See ../../native/README.md.
+//
+// Emscripten only. Nothing in this file is compiled for any other platform, and the
+// CMake block that adds it is guarded the same way.
+
+#pragma once
+
+#ifdef __EMSCRIPTEN__
+
+#include <string>
+#include <string_view>
+
+namespace PpssppWeb {
+
+// One turn of the browser's event loop, called from SDLMain's Emscripten main loop and
+// therefore always on the page's main thread. This is where every event is emitted:
+// what other threads produce is queued and drained here, and what can only be observed
+// (a boot completing, a frame rate, PPSSPP's own pause menu) is polled here.
+//
+// Returns false once the host has called ppsspp_web_shutdown, which is how the main
+// loop learns to stop.
+bool Frame();
+
+// Any thread. Queued, and emitted from Frame() on the main thread.
+void NotifyError(std::string_view message);
+void NotifySaveState(int slot, bool saved);
+
+}  // namespace PpssppWeb
+
+#endif  // __EMSCRIPTEN__
