  },
  "categorizeByGroup": true,
  "sort": [
    "source-order"
  ],
  "navigation": {
    "includeGroups": true,
    "includeFolders": true,
    "compactFolders": true
  },
  "headings": {
    "readme": false,
    "document": false
  },
  "externalSymbolLinkMappings": {
    "@wasm-gaming/engine-specs": {
      "*": "https://wasm-gaming.github.io/engine-specs/",
      "EventEmitter.off": "https://wasm-gaming.github.io/engine-specs/classes/EventEmitter.html#off",
      "CoreEvents": "https://wasm-gaming.github.io/engine-specs/interfaces/CoreEvents.html"
